# Required
OPENROUTER_API_KEY=sk-or-your-key-here

# OpenRouter model
OPENROUTER_MODEL=openai/gpt-4o-mini

# Your public website
SITE_URL=https://tahsinullahriyad.world

# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=https://tahsinullahriyad.world

# Optional tuning
RATE_LIMIT_PER_MINUTE=20
REQUEST_TIMEOUT_MS=120000
TEMPERATURE=0.7
MAX_TOKENS=1200

# Telegram appointment notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Protect appointment admin endpoints
APPOINTMENT_ADMIN_TOKEN=replace-with-a-long-random-token
APPOINTMENT_RATE_LIMIT=8
APPOINTMENTS_FILE=./data/appointments.json
